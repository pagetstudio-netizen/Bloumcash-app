# ============================================================
# Bloum Cash — Variables d'environnement (exemple)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer votre .env sur Git
# ============================================================

# ── Serveur ─────────────────────────────────────────────────
PORT=3001

# ── Base de données PostgreSQL (Supabase) ────────────────────
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxx:motdepasse@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# ── PayDunya (Tableau de bord : https://app.paydunya.com) ───
PAYDUNYA_MASTER_KEY=your_master_key_here
PAYDUNYA_PRIVATE_KEY=live_private_xxxxxxxxxxxx
PAYDUNYA_PUBLIC_KEY=live_public_xxxxxxxxxxxx
PAYDUNYA_TOKEN=your_token_here

# Mode sandbox pour les tests (mettre "true" pour tester sans vrai paiement)
# PAYDUNYA_SANDBOX=true

# ── GomboPlus / EgoPay ──────────────────────────────────────
GOMBOPLUS_PUBLIC_KEY=your_gomboplus_public_key
GOMBOPLUS_PRIVATE_KEY=your_gomboplus_private_key

# ── OneSignal (notifications push) ──────────────────────────
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_API_KEY=os_v2_app_xxxxxxxxxxxx

# ── JWT (générez des clés aléatoires sécurisées) ────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=changez_cette_valeur_avec_une_cle_aleatoire_securisee
USER_JWT_SECRET=changez_cette_valeur_avec_une_cle_aleatoire_securisee

# ── URL publique de l'app (pour callbacks PayDunya) ─────────
PAYDUNYA_CALLBACK_URL=https://votre-domaine.com
