<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laisser passer les routes API vers Node.js (Passenger)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Laisser passer les uploads
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteRule ^ - [L]

  # Servir les fichiers statiques existants directement (JS, CSS, images…)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Servir les dossiers existants directement
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres routes → index.html (SPA client-side routing)
  RewriteRule ^ /index.html [L]
</IfModule>
